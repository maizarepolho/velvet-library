* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}


body {
    background-color: #f7b2e0; /* Fundo rosa claro */
    color: #333;
}


.site-container {
    display: flex;
    max-width: 1440px;
    margin: 0 auto;
}


.main-content {
    flex: 3;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 15px;
}


/* Header */
.header {
    display: flex;
    align-items: center;
    gap: 15px;
}


.logo img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
}


.search-bar {
    background-color: #a83fa7;
    border-radius: 20px;
    padding: 8px 15px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
}


.search-bar input {
    border: none;
    background: transparent;
    color: white;
    outline: none;
    width: 100%;
}


.search-bar input::placeholder {
    color: #e0d0e0;
}


.search-bar i {
    color: white;
}


.auth-buttons {
    display: flex;
    gap: 10px;
}


.btn-yellow {
    background-color: #fce879;
    border: none;
    padding: 10px 20px;
    border-radius: 20px;
    font-weight: bold;
    cursor: pointer;
}


.header-icons {
    display: flex;
    gap: 10px;
}


.icon-btn {
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    cursor: pointer;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
}


.cart-btn { background-color: #e65287; color: white; }
.star-btn { background-color: #fce879; color: #e65287; }


/* Banner Promocional */
.banner {
    background-color: #f061a2;
    height: 120px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    padding: 20px;
    color: black;
    font-weight: bold;
    background-image: url('../imagens/banner.png');
    background-size: cover;
    background-position: center;
}


.banner-text h2 {
    background-color: rgba(255, 255, 255, 0.4);
    padding: 5px 10px;
}


/* Estrutura de Linhas e Flexbox */
.row {
    display: flex;
    gap: 15px;
    align-items: stretch;
}


.flex-1 { flex: 1; }
.flex-3 { flex: 3; }


.card-section {
    padding: 15px;
    border-radius: 12px;
}


.purple-box {
    background-color: #7b1fa2;
    color: white;
}


.pink-box {
    background-color: #c2185b;
    color: white;
}


/* Cabeçalho da seção de livros */
.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}


/* Carrossel de Livros */
.books-carousel {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
}


.book-card {
    display: flex;
    flex-direction: column;
    align-items: center;
}


.book-card .cover {
    width: 90px;
    height: 130px;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 5px;
}


.book-card .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}


.book-card span {
    font-size: 0.9rem;
    font-weight: bold;
    color: #fff;
}


.next-btn {
    background-color: #ff80ab;
    border: none;
    color: white;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    cursor: pointer;
    font-weight: bold;
    font-size: 1rem;
    flex-shrink: 0;
    margin-left: auto;
}


/* Categorias */
.categories-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    text-align: center;
}


.pills {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 10px 0;
    width: 100%;
}


.pill {
    background-color: #7b1fa2;
    color: white;
    padding: 6px 12px;
    border-radius: 15px;
    text-align: center;
    font-size: 0.85rem;
}


.see-more-btn {
    color: black;
    text-decoration: none;
    font-weight: bold;
    font-size: 1rem;
}


.see-more-inline {
    font-size: 0.8rem;
    color: white;
    text-decoration: none;
    font-weight: bold;
}


/* Seção Inferior */
.sub-section h4 {
    text-align: center;
    margin-bottom: 8px;
}


.yellow-box {
    background-color: #fce879;
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 5px;
}


.yellow-box ul {
    list-style: none;
}


.yellow-box li {
    margin-bottom: 5px;
    font-weight: bold;
}


.see-more {
    color: black;
    text-decoration: none;
    font-weight: bold;
    display: block;
    text-align: center;
}


/* Redes Sociais */
.social-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}


.social-icons {
    display: flex;
    gap: 15px;
    font-size: 2.5rem;
    margin-top: 10px;
}


.social-icons a { color: #e65287; }


/* Rodapé no Canto Inferior */
.bottom-footer {
    background-color: #880e4f;
    padding: 15px;
    border-radius: 8px;
    display: flex;
    align-items: center;
}


.bottom-footer ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
}


.bottom-footer a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    font-size: 0.9rem;
}


/* Barra Lateral Amarela (Direita) */
.sidebar {
    flex: 1;
    max-width: 320px;
    background-color: #fce879;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}


.sidebar-menu ul {
    list-style: none;
    padding: 30px 20px;
}


.sidebar-menu li {
    margin-bottom: 15px;
}


.sidebar-menu a {
    text-decoration: none;
    color: black;
    font-size: 1.1rem;
    font-weight: bold;
}


.sidebar-banner {
    padding: 10px;
}


.sidebar-banner img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
}


